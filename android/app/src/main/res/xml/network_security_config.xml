<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed ONLY to local dev instances (the Android analog of Apple's NSAllowsLocalNetworking).
     Production HTTPS instances are unaffected; content stays E2EE regardless of the transport. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- the emulator's alias for the host loopback -->
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
