<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The pre-Compose window theme (splash/initial). The real veyq look is the Compose VeyqTheme;
         this just gives a transparent, edge-to-edge, action-bar-less window for Compose to draw into.
         A framework parent avoids pulling the Material Components AAR (Compose does its own theming). -->
    <style name="Theme.Veyq" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
