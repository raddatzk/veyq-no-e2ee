# Local dev secrets — copy to `backend/.env` (gitignored) and fill in. Quarkus dev-mode (quarkusDev) loads
# `.env` from the backend module dir AUTOMATICALLY, so these reach the app without touching the tracked .run/
# run configs. Names map to config keys the usual way (UPPER_SNAKE → quarkus.* / veyq.*). Only override what
# you actually need — every value here has a working default in application-dev.properties / application.properties.

# --- Real outbound mail (default: mocked in dev, captured in the MockMailbox) ---
# Flip mock off, then supply your SMTP. e.g. a Mailtrap/Mailpit sandbox or a real provider.
#VEYQ_MAIL_MOCK=false
#MAIL_HOST=sandbox.smtp.example.com
#MAIL_PORT=587
#MAIL_USERNAME=your-smtp-user
#MAIL_PASSWORD=your-smtp-password
#MAIL_LOGIN=LOGIN
#MAIL_TLS=true
#MAIL_FROM=veyq <noreply@veyq.app>

# --- Blob store override (default: dev MinIO from infra/docker-compose.dev.yml) ---
# Point dev at an external S3 instead of the bundled MinIO. Any S3-compatible provider needs just FOUR values —
# endpoint + bucket + the two keys (Hetzner example shown):
#BLOB_STORE_BACKEND=s3
#BLOB_STORE_S3_ENDPOINT=https://fsn1.your-objectstorage.com
#BLOB_STORE_S3_BUCKET=your-bucket
#BLOB_STORE_S3_ACCESS_KEY=…
#BLOB_STORE_S3_SECRET_KEY=…
# Rarely needed:
#BLOB_STORE_S3_REGION=eu-central-1       # ONLY AWS enforces a region; MinIO/Hetzner/etc. accept the default
#BLOB_STORE_S3_PUBLIC_ENDPOINT=https://… # ONLY when the client-facing URL differs from the internal one

# --- Database override (default: jdbc:mariadb://localhost:3306/veyq, user veyq / pass change-me) ---
#DB_URL=jdbc:mariadb://localhost:3306/veyq
#DB_USER=veyq
#DB_PASSWORD=change-me
