# Feature: admin
# Use-case: Tenant Owner invites a new tenant member by email
# Use-case doc: ../../../../docs/wiki/features/admin/use-cases/uc.admin.invite-members-roles.md
#
# This file visualizes the server-visible HTTP flow. The E2EE key material marked with placeholders is
# produced client-side before the requests:
#
# 1. Tenant Owner unlocks their own TENANT_ROOT scope grant locally.
# 2. Tenant Owner client creates a one-time invite wrapping keypair.
# 3. Tenant Owner client wraps the tenant scope private key to the invite wrapping public key.
# 4. Invitee client later unwraps that invite wrap with the invite wrapping private key from the URL fragment.
# 5. Invitee client re-wraps the tenant scope private key to the invitee identity public key.
#
# Important current behavior: the member invite is not bound to the email address in the database. The
# email address is only used by the relay endpoint below. Whoever receives the complete link material can
# register a new account unless the product adds MEMBER targetEmail binding.

### 0. Variables expected by this file
# @baseUrl = http://localhost:8080
# @tenantId = <active tenant id>
# @ownerSessionToken = <Bearer token value without "Bearer ">
# @inviteeEmail = invited@example.test
# @inviteeDisplayName = Invited User
# @inviteePassword = correct-horse-battery-staple
# @tenantInviteRole = Member
#
# Existing tenant scope keypair (already stored server-side for this tenant):
# @tenantScopePublicKey = <base64url tenant scope public key>
# @tenantScopePrivateKey = <raw tenant scope private key, owner-unwrapped locally, never sent>
#
# Invite wrapping keypair, generated before step 1:
# @inviteWrappingPublicKey = <base64url invite wrapping KEM public key>
# @inviteWrappingPrivateKey = <base64url invite wrapping private key, kept in URL fragment only>
#
# Tenant scope private key wrapped for the invite transport:
# @tenantScopePrivateKeyWrappedToInvite = <base64url tenant scope private key wrapped to inviteWrappingPublicKey>

### 1. Tenant Owner issues an invite-wrap member invite
# Server stores: invite row, sha256(bootstrapSecret), inviteWrappingPublicKey, wrappedTenantScopePrivateKey.
# Server does not see: raw tenant scope private key, inviteWrappingPrivateKey.
POST {{baseUrl}}/api/tenant/member-invites
Authorization: Bearer {{ownerSessionToken}}
Content-Type: application/json

{
  "role": "{{tenantInviteRole}}",
  "inviteWrappingPublicKey": {
    "suiteId": "v1",
    "kemPublicKey": "{{inviteWrappingPublicKey}}"
  },
  "wrappedTenantScopePrivateKey": {
    "suiteId": "v1",
    "bytes": "{{tenantScopePrivateKeyWrappedToInvite}}"
  }
}

### 1b. Copy these values from the response
# @inviteId = <response.inviteId>
# @bootstrapSecret = <response.bootstrapSecret>
#
# The owner client now assembles a link. In pragmatic mode the fragment carries the invite wrapping private key:
# @inviteLink = {{baseUrl}}/tenant-invites/{{inviteId}}#bs={{bootstrapSecret}}&tk={{inviteWrappingPrivateKey}}
#
# In passphrase mode, the fragment carries only an encrypted invite wrapping private key and a salt. The passphrase
# must be shared out of band:
# @inviteLink = {{baseUrl}}/tenant-invites/{{inviteId}}#bs={{bootstrapSecret}}&ek=<encrypted-invite-wrapping-key>&ps=<salt>

### 2. Tenant Owner asks the server to email the already-built link
# Server validates Owner role, pending invite, tenant ownership, and link origin. It then relays the email.
# The EmailInviteRequest.email value is not currently persisted as the invite target for MEMBER invites.
POST {{baseUrl}}/api/tenant/member-invites/email
Authorization: Bearer {{ownerSessionToken}}
Content-Type: application/json

{
  "email": "{{inviteeEmail}}",
  "inviteId": "{{inviteId}}",
  "link": "{{inviteLink}}"
}

### 3. Invitee opens the link and loads public invite metadata
# No bootstrapSecret or invite wrapping private key is sent here. MEMBER metadata exposes only the tenant scope public key.
GET {{baseUrl}}/api/tenant-invites/{{inviteId}}

### 4. Invitee proves bootstrapSecret to fetch invite-wrapped onboarding material
# Server compares sha256(bootstrapSecret) with the stored secretHash.
POST {{baseUrl}}/api/tenant-invites/{{inviteId}}/material
Content-Type: application/json

{
  "bootstrapSecret": "{{bootstrapSecret}}"
}

### 4b. Client-side crypto before registration
# Inputs:
# - invite wrapping private key from URL fragment
# - material.inviteWrappingPublicKey from step 4
# - material.wrappedTenantScopePrivateKey from step 4
# - metadata.tenantScopePublicKey from step 3
#
# Invitee client:
# - unwraps material.wrappedTenantScopePrivateKey with inviteWrappingPrivateKey
# - creates identity keypair, master key, Secret Key, personal scope and key wraps
# - wraps the tenant scope private key to the invitee identity public key for the registration payload
#
# Outputs used by step 5:
# @identityKemPublicKey = <base64url invitee identity KEM public key>
# @identitySignPublicKey = <base64url invitee identity signing public key>
# @wrappedIdentityPrivateKey = <base64url identity private key wrapped under master key>
# @passwordMasterKeyWrap = <base64url master key wrapped under password + Secret Key KEK>
# @passwordKdfParams = <base64url encoded PASSWORD KDF params>
# @recoveryMasterKeyWrap = <base64url master key wrapped under Secret Key recovery KEK>
# @recoveryKdfParams = <base64url encoded RECOVERY KDF params>
# @recoveryMasterKeyTag = <base64url SHA-256("veyq/v1/recovery-auth" || masterKey)>
# @personalScopePublicKey = <base64url personal scope public key>
# @wrappedPersonalScopePrivateKey = <base64url personal scope private key wrapped to invitee identity>
# @tenantScopePublicKey = <metadata.tenantScopePublicKey.kemPublicKey>
# @tenantScopePrivateKeyWrappedToInvitee = <base64url tenant scope private key wrapped to invitee identity>

### 5. Invitee registers a new account via the member invite
# Server derives auth_verifier from password, stores only ciphertext/public key material, stores the
# tenant scope grant, creates ACTIVE membership, consumes the invite and returns a session.
POST {{baseUrl}}/api/tenant-invites/{{inviteId}}/register
Content-Type: application/json

{
  "bootstrapSecret": "{{bootstrapSecret}}",
  "email": "{{inviteeEmail}}",
  "displayName": "{{inviteeDisplayName}}",
  "password": "{{inviteePassword}}",
  "identityPublicKey": {
    "suiteId": "v1",
    "kemPublicKey": "{{identityKemPublicKey}}",
    "signPublicKey": "{{identitySignPublicKey}}"
  },
  "wrappedIdentityPrivateKey": {
    "suiteId": "v1",
    "bytes": "{{wrappedIdentityPrivateKey}}"
  },
  "masterKeyWraps": [
    {
      "unlockMethod": "PASSWORD",
      "suiteId": "v1",
      "wrappedKey": "{{passwordMasterKeyWrap}}",
      "kdfParams": "{{passwordKdfParams}}"
    },
    {
      "unlockMethod": "RECOVERY",
      "suiteId": "v1",
      "wrappedKey": "{{recoveryMasterKeyWrap}}",
      "kdfParams": "{{recoveryKdfParams}}"
    }
  ],
  "recoveryMasterKeyTag": "{{recoveryMasterKeyTag}}",
  "personalScopePublicKey": {
    "suiteId": "v1",
    "kemPublicKey": "{{personalScopePublicKey}}"
  },
  "wrappedPersonalScopePrivateKey": {
    "suiteId": "v1",
    "bytes": "{{wrappedPersonalScopePrivateKey}}"
  },
  "tenantScopePublicKey": {
    "suiteId": "v1",
    "kemPublicKey": "{{tenantScopePublicKey}}"
  },
  "wrappedTenantScopePrivateKey": {
    "suiteId": "v1",
    "bytes": "{{tenantScopePrivateKeyWrappedToInvitee}}"
  }
}
