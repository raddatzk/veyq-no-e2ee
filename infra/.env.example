##### RESTART SIDECAR ####
# Enables optional Compose services by profile.
# Use "reset" to start the reset sidecar together with the app.
# Also set RESET_USERNAME, RESET_PASSWORD, RESET_RESTART_CONTAINER, RESET_TRAEFIK_RULE
# COMPOSE_PROFILES=reset

# Username for the reset page.
RESET_USERNAME=admin

# Password for the reset page.
RESET_PASSWORD=change-reset-me

# Docker container name restarted after a successful reset.
#RESET_RESTART_CONTAINER=veyq
#### RESTART SIDECAR ####


#### PROXY ####
# Email address used by Let's Encrypt for certificate registration and expiry notices.
# REQUIRED
LETSENCRYPT_EMAIL=admin@example.com

# Traefik routing rule for the public Veyq application.
# Add more hosts with: Host(`cloud.example.com`) || Host(`www.example.com`)
# REQUIRED
VEYQ_TRAEFIK_RULE=Host(`cloud.example.com`)

# Traefik routing rule for the reset sidecar.
RESET_TRAEFIK_RULE=Host(`reset.example.com`)
#### PROXY ####


#### DATABASE ####
# MariaDB database name created on first database container startup.
#DB_NAME=veyq

# MariaDB application user created on first database container startup.
#DB_USER=veyq

# Password for the MariaDB application user.
# REQUIRED
DB_PASSWORD=change-me

# Password for the MariaDB root user.
# REQUIRED
DB_ROOT_PASSWORD=change-root-me
#### DATABASE ####

#### VEYQ COOKIES ####
# Whether auth cookies are marked Secure.
# Keep true when serving through HTTPS.
#COOKIE_SECURE=true

# Name of the access-token cookie.
#COOKIE_ACCESS_TOKEN_NAME=VEYQ_ACCESS_TOKEN

# Name of the refresh-token cookie.
#COOKIE_REFRESH_TOKEN_NAME=VEYQ_REFRESH_TOKEN
#### VEYQ COOKIES ####


#### VEYQ AUTHORIZATION ####
# Access-token lifetime in minutes.
#ACCESS_TOKEN_TTL_MINUTES=15

# Refresh-token lifetime in minutes.
# DEFAULT 60 Tage
#REFRESH_TOKEN_TTL_MINUTES=43200

# Number of days to retain access-token rows.
# Cleanup old access tokens
#ACCESS_TOKEN_AUDIT_TTL_DAYS=30

# Number of days to retain refresh-token rows.
# Cleanup old refresh tokens
#REFRESH_TOKEN_AUDIT_TTL_DAYS=90

# Cron expression for token cleanup to keep the database clean.
#TOKEN_CLEANUP_CRON='0 0 0 * * ?'

# Comma-separated origins allowed to use passkeys.
# Use HTTPS origins for public Compose deployments, for example https://cloud.example.com.
WEBAUTHN_ORIGINS=https://cloud.example.com

# Passkey relying-party domain, usually the public host without protocol.
# REQUIRED
WEBAUTHN_RP_ID=cloud.example.com

# Passkey display name shown by authenticators.
#WEBAUTHN_RP_NAME=veyq
#### VEYQ AUTHORIZATION ####


#### VEYQ INVITATIONS ####
# Number of days invitation tokens remain valid.
# Invitations are admin-triggered, they should stay valid longer so the user has enough time to notice the mail.
#INVITATION_TTL_DAYS=7

# Number of hours email-change confirmation tokens remain valid.
# Email changes are user-triggered, so the user can expect to receive an email soon.
#EMAIL_CHANGE_TTL_HOURS=24

# Number of hours password-reset tokens remain valid.
# Password resets are user-triggered, so the user can expect to receive an email soon.
#RESET_PASSWORD_TTL_HOURS=2

# Cron expression for cleaning old reset-password, invitation and email-change tokens.
#USER_CLEANUP_CRON='0 0 0 * * ?'

# Number of days to keep invalid user workflow tokens for audit/debugging and keeping the database clean.
#USER_CLEANUP_RETENTION_DAYS=30
#### VEYQ INVITATIONS ####


#### VEYQ BCRYPT ####
# Target bcrypt hashing time in milliseconds.
# Veyq regularly does a benchmark to find the highest bcrypt cost
# that generates a hash below this value
# This essentially will be the time it takes to perform a login
# BCRYPT_TARGET_MS=500

# Minimum bcrypt cost considered by the startup benchmark.
# BCRYPT_MIN_COST=10

# Maximum bcrypt cost considered by the startup benchmark.
# BCRYPT_MAX_COST=18

# Number of benchmark samples used to choose bcrypt cost.
# BCRYPT_BENCHMARK_SAMPLES=2
#### VEYQ BCRYPT ####


#### VEYQ MEDIA ####
# Media storage path inside the Veyq and reset containers.
#MEDIA_STORAGE_DIR=/data/veyq-media

# Upload chunk size in bytes.
# The clients splits larger files into chunks of this size for unstable connections
# If changed, make sure that MEDIA_MAX_UPLOAD_SIZE higher than this. This is the highest amount
# the webserver allows to receive (you can just double it in size)
#MEDIA_CHUNK_SIZE=16M

# Number of hours unfinished upload sessions remain valid.
# Unfinished uploads are cleaned up regularly, see MEDIA_UPLOAD_SESSION_CLEANUP_CRON
#MEDIA_UPLOAD_SESSION_TTL_HOURS=24

# Cron expression for upload-session cleanup to keep the database clean.
#MEDIA_UPLOAD_SESSION_CLEANUP_CRON='0 0 * * * ?'

# Maximum HTTP upload body size accepted by the backend.
# This usually should not be changed, but if so make sure it is higher than MEDIA_CHUNK_SIZE
#MEDIA_MAX_UPLOAD_SIZE=32M
#### VEYQ MEDIA ####


#### VEYQ MAIL ####
# Sender email address used by Veyq.
# Veyq sets the visible sender per mail as: Tenant Name <MAIL_FROM>
MAIL_FROM=noreply@example.com

# SMTP server hostname.
MAIL_HOST=smtp.example.com

# SMTP server port.
MAIL_PORT=587

# SMTP username.
MAIL_USERNAME=noreply@example.com

# SMTP password.
MAIL_PASSWORD=change-mail-me

# SMTP login mode used by Quarkus mailer.
MAIL_LOGIN=REQUIRED

# SMTP TLS mode used by Quarkus mailer.
MAIL_TLS=true
#### VEYQ MAIL ####
