#### veyq authorization ####
# Access-token lifetime in minutes.
#ACCESS_TOKEN_TTL_MINUTES=15

# Refresh-token lifetime in minutes.
# DEFAULT 60 Tage
#REFRESH_TOKEN_TTL_MINUTES=43200

# Number of days to retain access-token rows.
# Cleanup old access tokens
#ACCESS_TOKEN_AUDIT_TTL_DAYS=30

# Number of days to retain refresh-token rows.
# Cleanup old refresh tokens
#REFRESH_TOKEN_AUDIT_TTL_DAYS=90

# Cron expression for token cleanup to keep the database clean.
#TOKEN_CLEANUP_CRON='0 0 0 * * ?'

# Passkey display name shown by authenticators. Passkeys are bound to the current tenant domain.
#WEBAUTHN_RELYING_PARTY_NAME=veyq

# Stable secret used by Quarkus to encrypt persistent WebAuthn auth session data.
# Generated by setup. Keep this value stable across restarts.
WEBAUTHN_SESSION_ENCRYPTION_KEY=

# Compose deployments run behind Traefik. Keep these enabled so WebAuthn sees the public HTTPS host.
#PROXY_ADDRESS_FORWARDING=true
#PROXY_ALLOW_X_FORWARDED=true
#PROXY_ENABLE_FORWARDED_HOST=true

# Caps on concurrently held public-share live media-update long polls (per client IP and in total).
# Excess requests are rejected with HTTP 429 to protect Quarkus worker capacity from anonymous long polling.
#PUBLIC_SHARE_UPDATES_MAX_CONCURRENT_PER_IP=2
#PUBLIC_SHARE_UPDATES_MAX_CONCURRENT_TOTAL=64
# Same caps for authenticated memory live media-update long polls (per user and in total).
#MEMORY_UPDATES_MAX_CONCURRENT_PER_USER=4
#MEMORY_UPDATES_MAX_CONCURRENT_TOTAL=128
