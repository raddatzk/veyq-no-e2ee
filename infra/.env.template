#### veyq media storage (S3) ####
# Blobs (already-encrypted media frames) are stored in an S3-compatible object store — the server never keeps
# them locally. The store only ever sees AEAD ciphertext. Two ways to provision it:
#
#  (a) EXTERNAL S3 (AWS S3, Cloudflare R2, Backblaze B2, Wasabi, …): point veyq at your provider. The
#      veyq-minio container is NOT needed — start the stack normally.
#  (b) BUNDLED store: run `docker compose --profile s3 up` to start the included veyq-minio (MinIO) container;
#      the default endpoint already targets it. The access/secret below also seed MinIO's root credentials.
#
# CREDENTIALS ARE SECRETS: keep this .env out of version control (or use a secrets manager). The keys are read
# only by the backend, never persisted to the DB, never logged, and never handed to clients — clients that
# upload/download directly receive short-lived presigned URLs, not these keys.
BLOB_STORE_S3_ACCESS_KEY=change-me
BLOB_STORE_S3_SECRET_KEY=change-me-too
# For an external S3 the minimum is just ENDPOINT + BUCKET + the two keys above.
# Endpoint: leave as the bundled MinIO, or set your external provider's endpoint (e.g.
# https://s3.eu-central-1.amazonaws.com  or  https://fsn1.your-objectstorage.com for Hetzner).
#BLOB_STORE_S3_ENDPOINT=http://veyq-minio:9000
#BLOB_STORE_S3_BUCKET=veyq-blobs
# Region: only AWS enforces it (it checks the SigV4 scope against the endpoint). MinIO and Ceph-based stores
# (Hetzner, …) accept the default — leave this unset for anything but AWS.
#BLOB_STORE_S3_REGION=us-east-1

# DIRECT-TO-STORE (REQUIRED for the bundled MinIO). Transport is direct-to-store only: clients PUT/GET media
# frames straight to the object store via presigned URLs (the backend never proxies bytes), so the store must
# be reachable BY CLIENTS and presigned URLs are signed for this PUBLIC endpoint.
#  - BUNDLED MinIO: set this to your PUBLIC app origin and route the bucket path to MinIO via MINIO_TRAEFIK_RULE
#    below. Same origin as the web app ⇒ no CORS needed.
#  - EXTERNAL S3: leave EMPTY (the provider endpoint is already public) and configure that bucket's CORS to
#    allow your web origin (PUT+GET, expose ETag).
#BLOB_STORE_S3_PUBLIC_ENDPOINT=https://memories.example.com
# Traefik rule that path-routes the bucket to the bundled MinIO (host = your app host, path = the bucket name).
# Leave EMPTY for external S3. Example:
#MINIO_TRAEFIK_RULE=Host(`memories.example.com`) && PathPrefix(`/veyq-blobs`)
# Only needed when the store is on a DIFFERENT origin than the web app (e.g. a dedicated store subdomain).
# Comma-separated origins, or `*`. Empty for the same-origin path route above.
#MINIO_CORS_ALLOW_ORIGIN=

# Upload chunk size in bytes.
# The clients splits larger files into chunks of this size for unstable connections
# If changed, make sure that MEDIA_MAX_UPLOAD_SIZE higher than this. This is the highest amount
# the webserver allows to receive (you can just double it in size)
#MEDIA_CHUNK_SIZE=16M

# Number of hours unfinished upload sessions remain valid.
# Unfinished uploads are cleaned up regularly, see MEDIA_UPLOAD_SESSION_CLEANUP_CRON
#MEDIA_UPLOAD_SESSION_TTL_HOURS=24

# Cron expression for upload-session cleanup to keep the database clean.
#MEDIA_UPLOAD_SESSION_CLEANUP_CRON='0 0 * * * ?'

# Maximum HTTP upload body size accepted by the backend.
# This usually should not be changed, but if so make sure it is higher than MEDIA_CHUNK_SIZE
#MEDIA_MAX_UPLOAD_SIZE=32M

# ffmpeg executable used to generate a single JPEG poster for uploaded videos.
# Official veyq images include ffmpeg and keep video playback original-only in V1.
#FFMPEG_PATH=ffmpeg

# Maximum time spent generating one video poster.
#MEDIA_PREVIEW_TIMEOUT_SECONDS=15
