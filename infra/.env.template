##### RESTART SIDECAR ####
# Version of the local .env shape. The helper script updates this when safe defaults are added.
VEYQ_ENV_SCHEMA_VERSION=1

# Enables optional Compose services by profile.
# Use "reset" to start the reset sidecar together with the app.
# Use "updater" to start the internal auto-update sidecar.
# Also set RESET_USERNAME, RESET_PASSWORD, RESET_RESTART_CONTAINER, RESET_TRAEFIK_RULE
# COMPOSE_PROFILES=reset,updater

# Username for the reset page.
RESET_USERNAME=

# Password for the reset page.
RESET_PASSWORD=

# Docker container name restarted after a successful reset.
#RESET_RESTART_CONTAINER=veyq
#### RESTART SIDECAR ####

#### AUTO UPDATE SIDECAR ####
# Enables the veyq-updater sidecar when COMPOSE_PROFILES includes "updater".
# The sidecar is not publicly reachable and checks VEYQ_IMAGE for a newer digest.
# Use a major-channel image such as ghcr.io/raddatzk/veyq:1 for compatible updates.
VEYQ_AUTO_UPDATE_ENABLED=false

# Update check interval. Values below 1 hour are not supported.
VEYQ_AUTO_UPDATE_INTERVAL_HOURS=6

# Random delay added before each check so self-hosted instances do not all poll together.
VEYQ_AUTO_UPDATE_JITTER_MINUTES=30

# Shared secret used only by the updater status endpoints.
# Generated by setup when auto-updates are enabled.
VEYQ_UPDATER_NOTIFY_TOKEN=
#### AUTO UPDATE SIDECAR ####


#### PROXY ####
# Container image used by the production Compose stack.
# The GitHub Actions workflow publishes ghcr.io/<owner>/veyq:<tag>.
# REQUIRED for server installs. Local source builds can override this through docker-compose.build.yml.
VEYQ_IMAGE=ghcr.io/raddatzk/veyq:latest

# Email address used by Let's Encrypt for certificate registration and expiry notices.
# REQUIRED
LETSENCRYPT_EMAIL=

# Traefik routing rule for the public veyq application.
# Add more hosts with: Host(`veyq.example.com`) || Host(`memories.example.com`)
# REQUIRED
VEYQ_TRAEFIK_RULE=

# Traefik routing rule for the reset sidecar.
# Add more hosts with: Host(`reset.veyq.example.com`) || Host(`reset.memories.example.com`)
RESET_TRAEFIK_RULE=
#### PROXY ####


#### DATABASE ####
# MariaDB database name created on first database container startup.
#DB_NAME=veyq

# MariaDB application user created on first database container startup.
#DB_USER=veyq

# Password for the MariaDB application user.
# REQUIRED
DB_PASSWORD=

# Password for the MariaDB root user.
# REQUIRED
DB_ROOT_PASSWORD=
