# Local dev principal — copy this file to `.run/.env` (gitignored) and fill in the 5 inputs below.
# Then run the "Bootstrap User" run config (or `cd web && npm run bootstrap:user`) against a fresh backend:
# it creates ONE veyq_user that is Server Owner AND the tenant owner (with a personal scope) via the real
# operator-blind crypto, and writes VEYQ_SECRET_KEY + VEYQ_WRAPPED_MASTERKEY back into `.run/.env`.
# Throwaway dev creds for a local instance — never real secrets, never committed.

VEYQ_USERNAME=Kevin
VEYQ_EMAIL=kevin@veyq.test
VEYQ_PASSWORD=correct horse battery staple
VEYQ_TENANT=Familie Raddatz
VEYQ_TENANT_DOMAIN=veyq.localhost

# Filled by `npm run bootstrap:user` — leave blank:
VEYQ_SECRET_KEY=
VEYQ_WRAPPED_MASTERKEY=
