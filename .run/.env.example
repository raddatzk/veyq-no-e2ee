# Local dev principal — copy this file to `.run/.env` (gitignored) and fill in the inputs below.
# Then run the "Bootstrap User" run config (or `cd web && npm run bootstrap:user`) against a fresh backend:
# it creates the Server-Owner / tenant-owner veyq_user (with a personal scope) via the real operator-blind
# crypto, plus — when VEYQ_USER2_* is set — a second user onboarded as a tenant MEMBER (grant delivered), and
# writes the SECRET_KEY + WRAPPED_MASTERKEY pairs back into `.run/.env`.
# Throwaway dev creds for a local instance — never real secrets, never committed.

# VEYQ_USERNAME is your per-tenant handle (lowercased + unique in the tenant); the real name below is separate.
VEYQ_USERNAME=kevin
VEYQ_EMAIL=kevin@veyq.test
VEYQ_PASSWORD=correct horse battery staple
VEYQ_TENANT=Familie Raddatz
VEYQ_TENANT_DOMAIN=veyq.localhost

# Optional real name — sealed under K_tenant at accept (operator-blind); leave blank for a username-only join.
VEYQ_FIRST_NAME=Kevin
VEYQ_LAST_NAME=Raddatz

# Optional second user — onboarded as a tenant MEMBER with its grant delivered (a ready 2-member tenant for
# multi-member dev, e.g. sharing / add-member smokes). Leave all three blank to skip it.
VEYQ_USER2_USERNAME=other
VEYQ_USER2_EMAIL=other@veyq.test
VEYQ_USER2_PASSWORD=second dev throwaway passphrase

# Filled by `npm run bootstrap:user` — leave blank:
VEYQ_SECRET_KEY=
VEYQ_WRAPPED_MASTERKEY=
VEYQ_USER2_SECRET_KEY=
VEYQ_USER2_WRAPPED_MASTERKEY=
