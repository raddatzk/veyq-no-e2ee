### Authenticated account happy-path — signed login → unlock read → trust-device → session lifecycle
# The signed counterpart to login.http / unlock.http / trust-device.http (uc.account.login + unlock +
# trust-device). Unlike those boundary files, this drives the FULL journey with a REAL Ed25519 signature
# produced in-client: it imports the vendored tweetnacl facade (../_lib/ed25519.js) and signs the server
# nonce in a pre-request handler.
#
# PRECONDITION: a FRESH instance — request 1 self-seeds the owner with the test key's public key, and setup
# is single-owner-locked. Wipe first: docker compose -f backend/infra/docker-compose.yml down -v && up -d.
# The SEED below is a NON-SECRET test key (32 zero bytes); it never represents a real account.
#
# Run: ijhttp --env-file http/account/http-client.env.json --env dev http/account/authed-flow.http

### 1. Seed the owner with the test key's public key (operator-blind: the other fields are dummy ciphertext)
< {%
import {publicKeyB64} from '../_lib/ed25519.js';
const SEED = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
request.variables.set("authPub", publicKeyB64(SEED));
%}
POST {{host}}/api/setup/owner
Content-Type: application/json

{
  "email": "kevin@example.com",
  "displayName": "Kevin",
  "suiteId": "v1",
  "identityPublicKey": "aWRlbnRpdHktcHVibGljLWtleQ==",
  "wrappedIdentityPrivateKey": "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==",
  "authPublicKey": "{{authPub}}",
  "masterKeyWraps": [{ "method": "PASSWORD", "wrappedKey": "d3JhcHBlZC1tYXN0ZXIta2V5", "kdfParams": "AAAAAwAAgAAAAAABAAAAIHNhbHQtZXhhbXBsZS0xNmJ5dGVz" }],
  "recoveryMasterKeyTag": "cmVjb3ZlcnktdGFn"
}

> {%
client.test("owner created", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
});
%}

### 2. Request a login challenge → capture the nonce to sign
POST {{host}}/api/login/challenge
Content-Type: application/json

{ "email": "kevin@example.com" }

> {%
client.test("challenge returns a nonce", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.nonce && response.body.nonce.length > 0, "expected a nonce");
});
client.global.set("nonce", response.body.nonce);
%}

### 3. Sign the nonce and verify → a real session (capture the token pair)
< {%
import {signNonceB64} from '../_lib/ed25519.js';
const SEED = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
request.variables.set("sig", signNonceB64(SEED, client.global.get("nonce")));
%}
POST {{host}}/api/login/verify
Content-Type: application/json

{ "email": "kevin@example.com", "signature": "{{sig}}" }

> {%
client.test("signed verify issues a session", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.accessToken && response.body.refreshToken, "expected a token pair");
});
client.global.set("at1", response.body.accessToken);
client.global.set("rt1", response.body.refreshToken);
%}

### 4. Unlock read: the authenticated caller fetches its own key material (ciphertext only)
GET {{host}}/api/account/key-material
Authorization: Bearer {{at1}}
Accept: application/json

> {%
client.test("key material returns the caller's wraps", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.suiteId === "v1", "expected suite v1");
    client.assert(response.body.wrappedIdentityPrivateKey === "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==", "identity blob mismatch");
    client.assert(response.body.wraps.some(w => w.method === "PASSWORD"), "expected the PASSWORD floor wrap");
});
%}

### 5. Trust this device: add a DEVICE wrap → capture its id
POST {{host}}/api/account/wraps
Authorization: Bearer {{at1}}
Content-Type: application/json

{ "method": "DEVICE", "wrappedKey": "ZGV2aWNlLXdyYXAtY2lwaGVy", "kdfParams": "a2RmLXBhcmFtcw==" }

> {%
client.test("device wrap created", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.id && response.body.id.length > 0, "expected a wrap id");
});
client.global.set("wrapId", response.body.id);
%}

### 6. The DEVICE wrap now appears in the caller's key material
GET {{host}}/api/account/key-material
Authorization: Bearer {{at1}}
Accept: application/json

> {%
client.test("device wrap is now present", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.wraps.some(w => w.method === "DEVICE"), "expected the DEVICE wrap");
});
%}

### 7. Untrust this device: remove the DEVICE wrap (204)
DELETE {{host}}/api/account/wraps/{{wrapId}}
Authorization: Bearer {{at1}}

> {%
client.test("device wrap removed", function () {
    client.assert(response.status === 204, "expected 204, got " + response.status);
});
%}

### 8. Refresh rotates the token pair (capture the new pair)
POST {{host}}/api/token/refresh
Content-Type: application/json

{ "refreshToken": "{{rt1}}" }

> {%
client.test("refresh rotates the pair", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.accessToken && response.body.refreshToken, "expected a rotated pair");
});
client.global.set("at2", response.body.accessToken);
client.global.set("rt2", response.body.refreshToken);
%}

### 9. Replaying the superseded refresh token is a clone signal → the whole family is revoked
POST {{host}}/api/token/refresh
Content-Type: application/json

{ "refreshToken": "{{rt1}}" }

> {%
client.test("reused refresh token is rejected", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "refresh_rejected", "expected code refresh_rejected");
});
%}

### 10. The reuse revoked the family, so even the rotated access token is now dead
GET {{host}}/api/account/key-material
Authorization: Bearer {{at2}}
Accept: application/json

> {%
client.test("rotated token is dead after family revoke", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected code authentication_failed");
});
%}

### 11. Logout is idempotent — a 204 even for the already-revoked session
POST {{host}}/api/logout
Authorization: Bearer {{at2}}

> {%
client.test("logout is idempotent", function () {
    client.assert(response.status === 204, "expected 204, got " + response.status);
});
%}
