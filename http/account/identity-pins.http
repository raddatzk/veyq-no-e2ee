### Identity-pin store — signed happy-path over the sealed blob + its optimistic concurrency (uc.spaces.verify-identity)
# The authenticated round-trip for the operator-blind pin store (en.account.identity-pinning, cr-0098, ADR 0028):
# a born-empty account reads { blob: null, version: 0 }; a version-guarded PUT round-trips the opaque ciphertext
# and bumps the version; a write against a stale version is a 409 stale_version; the next write at the current
# version succeeds. The server only ever relays ONE opaque blob — it never sees a userId, a pinned key, or a count.
# The no-auth boundary (no anonymous read of the store) is asserted first and is runnable against any instance.
#
# PRECONDITION: a FRESH instance — request 2 self-seeds the owner with the test key's public key, and setup is
# single-owner-locked. Wipe first: docker compose -f infra/docker-compose.yml down -v && up -d. The SEED below is
# a NON-SECRET test key (32 zero bytes); it never represents a real account.
#
# Run: ijhttp --env-file http/account/http-client.env.json --env dev http/account/identity-pins.http

### 1. No bearer token → generic 401 (no anonymous read of the pin store; runnable against any instance)
GET {{host}}/api/account/identity-pins
Accept: application/json

> {%
client.test("anonymous read is a generic 401", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected code authentication_failed");
});
%}

### 2. Seed the owner with the test key's public key (operator-blind: the other fields are dummy ciphertext)
< {%
import {publicKeyB64} from '../_lib/ed25519.js';
const SEED = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
request.variables.set("authPub", publicKeyB64(SEED));
%}
POST {{host}}/api/setup/owner
Content-Type: application/json

{
  "email": "kevin@example.com",
  "displayName": "Kevin",
  "suiteId": "v1",
  "identityPublicKey": "aWRlbnRpdHktcHVibGljLWtleQ==",
  "wrappedIdentityPrivateKey": "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==",
  "authPublicKey": "{{authPub}}",
  "masterKeyWraps": [{ "method": "PASSWORD", "wrappedKey": "d3JhcHBlZC1tYXN0ZXIta2V5", "kdfParams": "AAAAAwAAgAAAAAABAAAAIHNhbHQtZXhhbXBsZS0xNmJ5dGVz" }],
  "recoveryMasterKeyTag": "cmVjb3ZlcnktdGFn"
}

> {%
client.test("owner created", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
});
%}

### 3. Login challenge → capture the nonce to sign
POST {{host}}/api/login/challenge
Content-Type: application/json

{ "email": "kevin@example.com" }

> {%
client.test("challenge returns a nonce", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
});
client.global.set("nonce", response.body.nonce);
%}

### 4. Sign the nonce → an owner session (capture the access token)
< {%
import {signNonceB64} from '../_lib/ed25519.js';
const SEED = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
request.variables.set("sig", signNonceB64(SEED, client.global.get("nonce")));
%}
POST {{host}}/api/login/verify
Content-Type: application/json

{ "email": "kevin@example.com", "signature": "{{sig}}" }

> {%
client.test("signed verify issues a session", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
});
client.global.set("at", response.body.accessToken);
%}

### 5. Born-empty store: the caller has never written → { blob: null, version: 0 }
GET {{host}}/api/account/identity-pins
Authorization: Bearer {{at}}
Accept: application/json

> {%
client.test("born-empty store reads null blob at version 0", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.blob === null, "expected a null blob");
    client.assert(response.body.version === 0, "expected version 0");
});
%}

### 6. First write at version 0 → stored, bumped to version 1 (the blob is opaque ciphertext, relayed verbatim)
PUT {{host}}/api/account/identity-pins
Authorization: Bearer {{at}}
Content-Type: application/json

{ "blob": "c2VhbGVkLXBpbnMtb25l", "version": 0 }

> {%
client.test("first write bumps to version 1", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.blob === "c2VhbGVkLXBpbnMtb25l", "expected the stored blob echoed");
    client.assert(response.body.version === 1, "expected version 1");
});
%}

### 7. Read back the sealed blob + its version
GET {{host}}/api/account/identity-pins
Authorization: Bearer {{at}}
Accept: application/json

> {%
client.test("the store now holds the blob at version 1", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.blob === "c2VhbGVkLXBpbnMtb25l", "blob mismatch");
    client.assert(response.body.version === 1, "expected version 1");
});
%}

### 8. A write still based on version 0 (a stale device) → 409 stale_version (client must re-read + merge)
PUT {{host}}/api/account/identity-pins
Authorization: Bearer {{at}}
Content-Type: application/json

{ "blob": "c2VhbGVkLXBpbnMtdHdv", "version": 0 }

> {%
client.test("stale version is a 409 stale_version", function () {
    client.assert(response.status === 409, "expected 409, got " + response.status);
    client.assert(response.body.code === "stale_version", "expected code stale_version");
});
%}

### 9. The rejected write left the store untouched (still version 1, still blob one)
GET {{host}}/api/account/identity-pins
Authorization: Bearer {{at}}
Accept: application/json

> {%
client.test("a rejected stale write does not mutate the store", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.blob === "c2VhbGVkLXBpbnMtb25l", "the blob must be unchanged");
    client.assert(response.body.version === 1, "the version must be unchanged");
});
%}

### 10. A write at the current version (1) → accepted, bumped to version 2
PUT {{host}}/api/account/identity-pins
Authorization: Bearer {{at}}
Content-Type: application/json

{ "blob": "c2VhbGVkLXBpbnMtdHdv", "version": 1 }

> {%
client.test("a write at the current version bumps to 2", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.blob === "c2VhbGVkLXBpbnMtdHdv", "expected the new blob");
    client.assert(response.body.version === 2, "expected version 2");
});
%}
