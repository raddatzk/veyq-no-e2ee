### Authenticated tenant terms of service — signed owner → terms lifecycle + accept gate (cr-0114, ADR 0035)
# The signed acceptance surface for uc.admin.tenant-terms + uc.account.accept-terms. The seeded owner creates a
# tenant on their OWN email and accepts it with a dummy (opaque, server-verbatim) grant, so they hold the tenant
# OWNER membership — then: PUT terms bumps the version, an idempotent re-save does NOT bump, GET reflects the
# caller's acceptedVersion, accept records it, a bump re-stales, and a stale accept is 409. The non-owner 403 is
# covered by the backend slice test (TenantTermsSliceTest) — it needs a second signed identity, out of scope here.
#
# PRECONDITION: a FRESH instance (step 1 self-seeds the owner; setup is single-owner-locked — the seed tolerates
# a 409 so this also runs after tenant-authed.http on the same instance). SEED is a NON-SECRET test key.
# Wipe: docker compose -f infra/docker-compose.yml down -v && up -d.
#
# Run: ijhttp --env-file http/admin/http-client.env.json --env dev http/admin/tenant-terms-authed.http

### 1. Seed the Server Owner with the test key's public key (201 fresh, or 409 if already seeded)
< {%
import {publicKeyB64} from '../_lib/ed25519.js';
const SEED = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
request.variables.set("authPub", publicKeyB64(SEED));
%}
POST {{host}}/api/setup/owner
Content-Type: application/json

{
  "email": "kevin@example.com",
  "displayName": "Kevin",
  "suiteId": "v1",
  "identityPublicKey": "aWRlbnRpdHktcHVibGljLWtleQ==",
  "wrappedIdentityPrivateKey": "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==",
  "authPublicKey": "{{authPub}}",
  "masterKeyWraps": [{ "method": "PASSWORD", "wrappedKey": "d3JhcHBlZC1tYXN0ZXIta2V5", "kdfParams": "AAAAAwAAgAAAAAABAAAAIHNhbHQtZXhhbXBsZS0xNmJ5dGVz" }],
  "recoveryMasterKeyTag": "cmVjb3ZlcnktdGFn"
}

> {%
client.test("owner seeded (or already present)", function () {
    client.assert(response.status === 201 || response.status === 409, "expected 201 or 409, got " + response.status);
});
%}

### 2. Login challenge → capture the nonce
POST {{host}}/api/login/challenge
Content-Type: application/json

{ "email": "kevin@example.com" }

> {%
client.test("challenge returns a nonce", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
});
client.global.set("nonce", response.body.nonce);
%}

### 3. Sign the nonce and verify → an owner session
< {%
import {signNonceB64} from '../_lib/ed25519.js';
const SEED = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
request.variables.set("sig", signNonceB64(SEED, client.global.get("nonce")));
%}
POST {{host}}/api/login/verify
Content-Type: application/json

{ "email": "kevin@example.com", "signature": "{{sig}}" }

> {%
client.test("signed verify issues a session", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
});
client.global.set("at", response.body.accessToken);
%}

### 4. Create a tenant on the OWNER's own email → PENDING (capture id + bootstrap secret)
POST {{host}}/api/tenants
Authorization: Bearer {{at}}
Content-Type: application/json

{ "tenantName": "Terms Fam", "domain": "terms-authed.example.com", "ownerEmail": "kevin@example.com" }

> {%
client.test("tenant created PENDING", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.tenantId, "expected a tenantId");
    client.assert(response.body.bootstrapSecret, "expected a bootstrapSecret");
});
client.global.set("tenantId", response.body.tenantId);
client.global.set("secret", response.body.bootstrapSecret);
%}

### 5. Accept as the invited owner (dummy opaque grant) → ACTIVE + the caller holds OWNER membership
POST {{host}}/api/tenants/accept
Authorization: Bearer {{at}}
Content-Type: application/json

{ "bootstrapSecret": "{{secret}}", "username": "kevinowner", "grant": "AQ==" }

> {%
client.test("tenant activated, caller is owner", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.status === "ACTIVE", "expected ACTIVE");
});
%}

### 6. Owner sets terms → version 1, echoed back
PUT {{host}}/api/tenants/{{tenantId}}/terms
Authorization: Bearer {{at}}
Content-Type: application/json

{ "terms": { "de": "## Regeln\nSei nett.", "en": "## Rules\nBe kind." } }

> {%
client.test("first publish bumps to version 1", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.termsVersion === 1, "expected termsVersion 1, got " + response.body.termsVersion);
    client.assert(response.body.acceptedVersion === 0, "expected acceptedVersion 0");
    client.assert(response.body.terms.de === "## Regeln\nSei nett.", "expected the DE terms echoed");
});
%}

### 7. Idempotent re-save (only whitespace differs → normalizes equal) → NO bump
PUT {{host}}/api/tenants/{{tenantId}}/terms
Authorization: Bearer {{at}}
Content-Type: application/json

{ "terms": { "de": "  ## Regeln\nSei nett.  ", "en": "## Rules\nBe kind.\n" } }

> {%
client.test("idempotent re-save does not bump", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.termsVersion === 1, "expected termsVersion still 1, got " + response.body.termsVersion);
});
%}

### 8. A real change → bump to 2
PUT {{host}}/api/tenants/{{tenantId}}/terms
Authorization: Bearer {{at}}
Content-Type: application/json

{ "terms": { "de": "## Regeln v2", "en": "## Rules v2" } }

> {%
client.test("a real change bumps to version 2", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.termsVersion === 2, "expected termsVersion 2, got " + response.body.termsVersion);
});
%}

### 9. GET reflects the current version + the caller's (not yet) acceptance
GET {{host}}/api/tenants/{{tenantId}}/terms
Authorization: Bearer {{at}}
Accept: application/json

> {%
client.test("GET shows version 2, unaccepted", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.termsVersion === 2, "expected termsVersion 2");
    client.assert(response.body.acceptedVersion === 0, "expected acceptedVersion 0");
});
%}

### 10. Accept the current version → acceptedVersion catches up
POST {{host}}/api/tenants/{{tenantId}}/terms/accept
Authorization: Bearer {{at}}
Content-Type: application/json

{ "version": 2 }

> {%
client.test("accept records the current version", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.acceptedVersion === 2, "expected acceptedVersion 2, got " + response.body.acceptedVersion);
});
%}

### 11. A bump re-stales the caller
PUT {{host}}/api/tenants/{{tenantId}}/terms
Authorization: Bearer {{at}}
Content-Type: application/json

{ "terms": { "de": "## Regeln v3", "en": "## Rules v3" } }

> {%
client.test("bump to version 3", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.termsVersion === 3, "expected termsVersion 3");
    client.assert(response.body.acceptedVersion === 2, "expected the acceptance now stale at 2");
});
%}

### 12. Accepting the now-stale version 2 is refused (409)
POST {{host}}/api/tenants/{{tenantId}}/terms/accept
Authorization: Bearer {{at}}
Content-Type: application/json

{ "version": 2 }

> {%
client.test("a stale accept is 409 terms_version_changed", function () {
    client.assert(response.status === 409, "expected 409, got " + response.status);
    client.assert(response.body.code === "terms_version_changed", "expected code terms_version_changed");
});
%}

### 13. Re-accepting the current version 3 clears the gate again
POST {{host}}/api/tenants/{{tenantId}}/terms/accept
Authorization: Bearer {{at}}
Content-Type: application/json

{ "version": 3 }

> {%
client.test("re-accept records version 3", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.acceptedVersion === 3, "expected acceptedVersion 3");
});
%}
