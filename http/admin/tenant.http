### 11. Accept (existing-user path) with no bearer → 401 (@Authenticated, central auth)
POST {{host}}/api/tenants/accept
Content-Type: application/json

{ "bootstrapSecret": "never-issued-token", "grant": "AQ==" }

> {%
client.test("anonymous accept is a generic 401", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected code authentication_failed");
});
%}

### 12. Preview with an unknown bootstrap secret → 404 (public: reaches the handler, no session needed)
POST {{host}}/api/tenants/accept/preview
Content-Type: application/json

{ "bootstrapSecret": "never-issued-token" }

> {%
client.test("preview of an unknown secret is 404 invite_not_found", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.code === "invite_not_found", "expected code invite_not_found");
});
%}

### 13. Preview with a blank bootstrap secret → 400 (public endpoint, boundary validation runs)
POST {{host}}/api/tenants/accept/preview
Content-Type: application/json

{ "bootstrapSecret": "   " }

> {%
client.test("preview of a blank secret is rejected at the boundary", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
});
%}

### 14. Register-and-accept with an unknown secret (valid-shaped account) → 404 (public, reaches the handler)
POST {{host}}/api/tenants/accept/register
Content-Type: application/json

{ "bootstrapSecret": "never-issued-token",
  "account": { "displayName": "New Owner", "suiteId": "v1",
    "identityPublicKey": "aWRlbnRpdHktcHVibGljLWtleQ==",
    "wrappedIdentityPrivateKey": "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==",
    "authPublicKey": "ZWQyNTUxOS1hdXRoLXB1Yg==",
    "masterKeyWraps": [{ "method": "PASSWORD", "wrappedKey": "d3JhcHBlZC1tYXN0ZXIta2V5", "kdfParams": "a2RmLXBhcmFtcw==" }],
    "recoveryMasterKeyTag": "cmVjb3ZlcnktdGFn" },
  "grant": "AQ==" }

> {%
client.test("register with an unknown secret is 404 invite_not_found", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.code === "invite_not_found", "expected code invite_not_found");
});
%}

### 15. Register-and-accept with a malformed account (blank displayName) → 400 at the boundary
POST {{host}}/api/tenants/accept/register
Content-Type: application/json

{ "bootstrapSecret": "never-issued-token",
  "account": { "displayName": "   ", "suiteId": "v1",
    "identityPublicKey": "aWRlbnRpdHktcHVibGljLWtleQ==",
    "wrappedIdentityPrivateKey": "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==",
    "authPublicKey": "ZWQyNTUxOS1hdXRoLXB1Yg==",
    "masterKeyWraps": [{ "method": "PASSWORD", "wrappedKey": "d3JhcHBlZC1tYXN0ZXIta2V5", "kdfParams": "a2RmLXBhcmFtcw==" }] },
  "grant": "AQ==" }

> {%
client.test("register with a blank display name is rejected at the boundary", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
});
%}

### --- Member-invite management (uc.spaces.manage-member-invites / cr-0082) ---
# All three are @Authenticated with the OWNER-membership check in the handler, so an anonymous caller is a
# uniform 401 BEFORE any tenant/invite lookup — no pre-auth leak of tenant/invite existence. The owner-gated
# happy path (list → re-issue → revoke) and the non-owner 403 need a signed member/owner session and so are
# covered by MemberInviteManagementSliceTest + the web round-trip (cr-0082 phase 4).

### 16. List member invites with no bearer → 401 (auth precedes tenant lookup)
GET {{host}}/api/tenants/11111111-1111-1111-1111-111111111111/member-invites
Accept: application/json

> {%
client.test("anonymous list member-invites is a generic 401 (not a 404)", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected code authentication_failed");
});
%}

### 17. Re-issue a member invite with no bearer → 401 (auth precedes tenant/invite lookup)
POST {{host}}/api/tenants/11111111-1111-1111-1111-111111111111/member-invites/22222222-2222-2222-2222-222222222222/reissue

> {%
client.test("anonymous reissue member-invite is a generic 401 (not a 404)", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected code authentication_failed");
