### First-run server setup (uc.admin.setup-server)
# Runnable acceptance for the setup API. Run against a FRESH instance (in-memory H2, no owner).
# Requests run top-to-bottom and share server state, so order matters.
# Run: ijhttp --env-file http/admin/http-client.env.json --env dev http/admin/setup.http

### 1. A fresh instance reports setup is required
GET {{host}}/api/setup
Accept: application/json

> {%
client.test("setup required, suite v1 advertised", function () {
    client.assert(response.status === 200, "status " + response.status);
    client.assert(response.body.setupRequired === true, "expected setupRequired=true");
    client.assert(response.body.suites[0] === "v1", "expected suite v1");
});
%}

### 2. A blank display name is rejected at the boundary
POST {{host}}/api/setup/owner
Content-Type: application/json

{
  "email": "kevin@example.com",
  "displayName":"   ",
  "suiteId": "v1",
  "identityPublicKey": "aWRlbnRpdHktcHVibGljLWtleQ==",
  "wrappedIdentityPrivateKey": "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==",
  "authPublicKey": "ZWQyNTUxOS1hdXRoLXB1Yg==",
  "masterKeyWraps": [{ "method": "PASSWORD", "wrappedKey": "d3JhcHBlZC1tYXN0ZXIta2V5", "kdfParams": "AAAAAwAAgAAAAAABAAAAIHNhbHQtZXhhbXBsZS0xNmJ5dGVz" }],
  "recoveryMasterKeyTag": "cmVjb3ZlcnktdGFn"
}

> {%
client.test("blank display name rejected", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
});
%}

### 3. Non-base64 key material is rejected
POST {{host}}/api/setup/owner
Content-Type: application/json

{
  "email": "kevin@example.com",
  "displayName":"Kevin",
  "suiteId": "v1",
  "identityPublicKey": "aWRlbnRpdHktcHVibGljLWtleQ==",
  "wrappedIdentityPrivateKey": "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==",
  "authPublicKey": "not base64!!",
  "masterKeyWraps": [{ "method": "PASSWORD", "wrappedKey": "d3JhcHBlZC1tYXN0ZXIta2V5", "kdfParams": "AAAAAwAAgAAAAAABAAAAIHNhbHQtZXhhbXBsZS0xNmJ5dGVz" }]
}

> {%
client.test("non-base64 key rejected", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
});
%}

### 4. A valid owner is created and setup is locked
POST {{host}}/api/setup/owner
Content-Type: application/json

{
  "email": "kevin@example.com",
  "displayName":"  Kevin  ",
  "suiteId": "v1",
  "identityPublicKey": "aWRlbnRpdHktcHVibGljLWtleQ==",
  "wrappedIdentityPrivateKey": "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==",
  "authPublicKey": "ZWQyNTUxOS1hdXRoLXB1Yg==",
  "masterKeyWraps": [{ "method": "PASSWORD", "wrappedKey": "d3JhcHBlZC1tYXN0ZXIta2V5", "kdfParams": "AAAAAwAAgAAAAAABAAAAIHNhbHQtZXhhbXBsZS0xNmJ5dGVz" }],
  "recoveryMasterKeyTag": "cmVjb3ZlcnktdGFn"
}

> {%
client.test("owner created", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.userId !== null, "expected a userId");
});
%}

### 5. Setup is no longer required
GET {{host}}/api/setup
Accept: application/json

> {%
client.test("setup no longer required", function () {
    client.assert(response.status === 200, "status " + response.status);
    client.assert(response.body.setupRequired === false, "expected setupRequired=false");
});
%}

### 6. A second owner is rejected (single-owner lock)
POST {{host}}/api/setup/owner
Content-Type: application/json

{
  "email": "kevin@example.com",
  "displayName":"Mallory",
  "suiteId": "v1",
  "identityPublicKey": "aWRlbnRpdHktcHVibGljLWtleQ==",
  "wrappedIdentityPrivateKey": "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==",
  "authPublicKey": "ZWQyNTUxOS1hdXRoLXB1Yg==",
  "masterKeyWraps": [{ "method": "PASSWORD", "wrappedKey": "d3JhcHBlZC1tYXN0ZXIta2V5", "kdfParams": "AAAAAwAAgAAAAAABAAAAIHNhbHQtZXhhbXBsZS0xNmJ5dGVz" }]
}

> {%
client.test("second owner rejected", function () {
    client.assert(response.status === 409, "expected 409, got " + response.status);
    client.assert(response.body.code === "setup_already_complete", "expected code setup_already_complete");
});
%}
