### Background-task pull queue — signed boundary + authenticated no-grant/non-member paths (ADR 0021, cr-0076)
# What a bare .http CAN prove over the wire against a fresh instance: the auth boundary (401 before anything),
# request validation (400), and the authenticated semantics that need NO scope key — "no grant ⇒ nothing
# claimable" (204), "enqueue onto a scope you don't hold ⇒ 403", and "act on an unknown job ⇒ 404" (incl. the
# cr-0098 grant-delivery **decline**). The FULL grant-delivery happy-path (seed a grant-less membership → claim →
# wrap K_SC to a foreign identity → complete → the membership holds the grant) needs the operator-blind
# scope-grant flow — a real ML-KEM wrap the client crypto suite produces, not reproducible from a bare .http
# (same wall content.http hit). It is covered end-to-end at the integration layer (backend TasksSliceTest, which
# seeds the grant-less membership in-tx and drives claim→complete→deliver over the HTTP stack) and by the web
# worker loop (cr-0076 phase 4); a live web smoke lands with member onboarding (cr-0077). The decline's
# **leased** paths (release-to-others + the per-worker exclusion + the 409 not_lease_holder) likewise need a
# leased job across two seeded workers → covered at the slice layer (TasksSliceTest, cr-0098).
#
# PRECONDITION: a FRESH instance — request 1 self-seeds the owner and setup is single-owner-locked. Wipe first:
# docker compose -f infra/docker-compose.yml down -v && up -d. SEED is a NON-SECRET test key.
#
# Run: ijhttp --env-file http/tasks/http-client.env.json --env dev http/tasks/tasks.http

### 1. claim without a bearer token → generic 401 (auth before anything)
POST {{host}}/api/tasks/claim
Content-Type: application/json

{ "capabilityTags": ["02f271ff"] }

> {%
client.test("claim requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected authentication_failed");
});
%}

### 2. enqueue without a bearer token → 401
POST {{host}}/api/tasks/enqueue
Content-Type: application/json

{ "scopeId": "00000000-0000-0000-0000-000000000000", "capabilityTag": "9f3a1c04" }

> {%
client.test("enqueue requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
});
%}

### 3. Seed the Server Owner with the test key's public key
< {%
import {publicKeyB64} from '../_lib/ed25519.js';
const SEED = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
request.variables.set("authPub", publicKeyB64(SEED));
%}
POST {{host}}/api/setup/owner
Content-Type: application/json

{
  "email": "kevin@example.com",
  "displayName": "Kevin",
  "suiteId": "v1",
  "identityPublicKey": "aWRlbnRpdHktcHVibGljLWtleQ==",
  "wrappedIdentityPrivateKey": "d3JhcHBlZC1pZGVudGl0eS1wcml2YXRlLWtleQ==",
  "authPublicKey": "{{authPub}}",
  "masterKeyWraps": [{ "method": "PASSWORD", "wrappedKey": "d3JhcHBlZC1tYXN0ZXIta2V5", "kdfParams": "AAAAAwAAgAAAAAABAAAAIHNhbHQtZXhhbXBsZS0xNmJ5dGVz" }],
  "recoveryMasterKeyTag": "cmVjb3ZlcnktdGFn"
}

> {%
client.test("owner created", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
});
%}

### 4. Login challenge → capture the nonce
POST {{host}}/api/login/challenge
Content-Type: application/json

{ "email": "kevin@example.com" }

> {%
client.test("challenge returns a nonce", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
});
client.global.set("nonce", response.body.nonce);
%}

### 5. Sign the nonce → an owner session
< {%
import {signNonceB64} from '../_lib/ed25519.js';
const SEED = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
request.variables.set("sig", signNonceB64(SEED, client.global.get("nonce")));
%}
POST {{host}}/api/login/verify
Content-Type: application/json

{ "email": "kevin@example.com", "signature": "{{sig}}" }

> {%
client.test("signed verify issues a session", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
});
client.global.set("at", response.body.accessToken);
%}

### 6. Authenticated claim, but the owner holds NO scope grant → 204 (nothing claimable)
POST {{host}}/api/tasks/claim
Authorization: Bearer {{at}}
Content-Type: application/json

{ "capabilityTags": ["02f271ff"] }

> {%
client.test("no grant ⇒ nothing claimable", function () {
    client.assert(response.status === 204, "expected 204, got " + response.status);
});
%}

### 7. claim with empty capability tags → 400 (validation, boundary before the handler)
POST {{host}}/api/tasks/claim
Authorization: Bearer {{at}}
Content-Type: application/json

{ "capabilityTags": [] }

> {%
client.test("empty tags rejected", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
});
%}

### 8. enqueue onto a scope the caller is not a member of → 404 scope_not_found
# Membership is the first guard (ADR 0042): a non-member gets the same answer as for a scope that does not
# exist, so scope ids are not enumerable. (A *member* who holds no grant would get 403 not_key_holder.)
POST {{host}}/api/tasks/enqueue
Authorization: Bearer {{at}}
Content-Type: application/json

{ "scopeId": "00000000-0000-0000-0000-000000000000", "capabilityTag": "9f3a1c04", "sealedBody": "AQ==" }

> {%
client.test("enqueue outside your scopes ⇒ 404", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.code === "scope_not_found", "expected scope_not_found");
});
%}

### 9. complete an unknown job → 404 job_not_found
POST {{host}}/api/tasks/11111111-1111-1111-1111-111111111111/complete
Authorization: Bearer {{at}}
Content-Type: application/json

{ "sealedResult": "AQ==" }

> {%
client.test("complete unknown job ⇒ 404", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.code === "job_not_found", "expected job_not_found");
});
%}

