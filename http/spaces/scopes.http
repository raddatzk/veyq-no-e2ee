### Scopes — list & switch boundary (uc.spaces.switch-spaces)
# The unauthenticated boundary of the scope endpoints, runnable against ANY instance (no account/token
# needed). The authenticated happy-path (list tenants/scopes, birth a personal scope) + the non-member
# authz path are covered at the integration layer (ScopesSliceTest, which seeds a member+tenant in-tx) and
# in the web client — those need the full operator-blind grant flow, not reproducible from a bare .http.
#
# Run: ijhttp --env-file http/spaces/http-client.env.json --env dev http/spaces/scopes.http

### 1. GET /api/scopes/my-tenants without a bearer token → generic 401
GET {{host}}/api/scopes/my-tenants

> {%
client.test("my-tenants requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected authentication_failed");
});
%}

### 2. GET /api/scopes without a bearer token → 401
GET {{host}}/api/scopes
X-Forwarded-Host: 127.0.0.1

> {%
client.test("list scopes requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
});
%}

### 3. POST /api/scopes (birth personal) without a bearer token → 401 (auth is checked before the body)
POST {{host}}/api/scopes
Content-Type: application/json
X-Forwarded-Host: 127.0.0.1

{ "wrappedGrant": "AQ==" }

> {%
client.test("birth personal scope requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
});
%}

### 4. POST /api/scopes/groups (create group) without a bearer token → 401 (auth is checked before the body)
# The authenticated group create/list happy-path + the non-member authz path are covered at the integration
# layer (ScopesSliceTest) + the web client — they need the full operator-blind grant flow (a fresh K_SC, the
# sealed name + self-grant), not reproducible from a bare .http.
POST {{host}}/api/scopes/groups
Content-Type: application/json
X-Forwarded-Host: 127.0.0.1

{ "encryptedName": "c2VhbGVkLW5hbWU=", "wrappedGrant": "AQ==" }

> {%
client.test("create group requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
});
%}

### 5. POST /api/scopes/{scopeId}/members (add a group member by username) without a bearer token → 401
# The owner-gated happy-path (admit an existing tenant member by username → grant-less membership) + the authz
# paths (non-owner 403, unknown username 404, already-member 409) are covered at the integration layer
# (ScopesSliceTest) — they need a seeded group + a second tenant member, not reproducible from a bare .http.
POST {{host}}/api/scopes/7c3f0e2a-9b1d-4a6e-8b2c-1f2d3e4a5b6c/members
Content-Type: application/json
X-Forwarded-Host: 127.0.0.1

{ "username": "partner" }

> {%
client.test("add group member requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
});
%}

### 6. Group member management (cr-0088) without a bearer token → 401 (auth is checked before the body)
# The owner-gated happy-paths (promote/demote, remove + last-owner guard, rotation-commit + re-grant) are covered
# at the integration layer (ScopesSliceTest) — they need a seeded group + members + the epoch grant flow, not a
# bare .http. Here only the unauth boundary of each op.
PATCH {{host}}/api/scopes/7c3f0e2a-9b1d-4a6e-8b2c-1f2d3e4a5b6c/members/9b1d4a6e-8b2c-1f2d-3e4a-5b6c7c3f0e2a
Content-Type: application/json
X-Forwarded-Host: 127.0.0.1

{ "role": "OWNER" }

> {%
client.test("set member role requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
});
%}

### 7. DELETE a group member without a bearer token → 401
DELETE {{host}}/api/scopes/7c3f0e2a-9b1d-4a6e-8b2c-1f2d3e4a5b6c/members/9b1d4a6e-8b2c-1f2d-3e4a-5b6c7c3f0e2a
X-Forwarded-Host: 127.0.0.1

> {%
client.test("remove member requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
});
%}

### 8. POST a rotation-commit without a bearer token → 401
POST {{host}}/api/scopes/7c3f0e2a-9b1d-4a6e-8b2c-1f2d3e4a5b6c/epochs
Content-Type: application/json
X-Forwarded-Host: 127.0.0.1

{ "wrappedPrev": "AQ==", "grants": [] }

> {%
client.test("rotate scope requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
});
%}

### 9. DELETE a group (soft-delete) without a bearer token → 401 (cr-0090)
DELETE {{host}}/api/scopes/7c3f0e2a-9b1d-4a6e-8b2c-1f2d3e4a5b6c
X-Forwarded-Host: 127.0.0.1

> {%
client.test("delete group requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected authentication_failed");
});
%}

### 10. POST a group restore without a bearer token → 401 (cr-0090)
POST {{host}}/api/scopes/7c3f0e2a-9b1d-4a6e-8b2c-1f2d3e4a5b6c/restore
X-Forwarded-Host: 127.0.0.1

> {%
client.test("restore group requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected authentication_failed");
});
%}

### 11. Consent group-add (cr-0094): resolve a candidate without a bearer token → 401
# The owner-gated happy-path (resolve → { identityPublicKey, requiresConsent }, then a consent-gated add that
# seals the group name to the invitee) is a signed key-holder flow covered at the integration layer
# (ConsentGroupAddSliceTest) + the web client — the name-seal needs a real identity + the opened group key, not
# reproducible from a bare .http. Here only the unauth boundary.
POST {{host}}/api/scopes/7c3f0e2a-9b1d-4a6e-8b2c-1f2d3e4a5b6c/members/resolve
Content-Type: application/json
X-Forwarded-Host: 127.0.0.1

{ "username": "partner" }

> {%
client.test("resolve group member requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected authentication_failed");
});
%}

### 12. Consent group-add (cr-0096): the consent-gated add boundary without a bearer token → 401
# A consent proposal add (username + sealedNameKey, the wrapped derived name-key K_name) is still auth-checked
# before the body. The consent branch itself (a requiresConsent target → soft pendingConsent row, grant-delivery
# skips it; no name-key → 400 consent_required) is covered at the integration layer (ConsentGroupAddSliceTest).
POST {{host}}/api/scopes/7c3f0e2a-9b1d-4a6e-8b2c-1f2d3e4a5b6c/members
Content-Type: application/json
X-Forwarded-Host: 127.0.0.1

{ "username": "partner", "sealedNameKey": "c2VhbGVkLW5hbWUta2V5" }

> {%
client.test("consent-gated add requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
});
%}

### 13. Consent group-add (cr-0094): accept a proposal without a bearer token → 401 (invitee-gated)
POST {{host}}/api/scopes/7c3f0e2a-9b1d-4a6e-8b2c-1f2d3e4a5b6c/invitations/accept
X-Forwarded-Host: 127.0.0.1

> {%
client.test("accept invitation requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected authentication_failed");
});
%}

