%}

### 5. Move media between buckets without a bearer token → 401
POST {{host}}/api/scopes/00000000-0000-0000-0000-000000000000/nodes/00000000-0000-0000-0000-000000000000/media-moves
Content-Type: application/json

{ "mediaIds": ["00000000-0000-0000-0000-000000000000"], "targetBucketId": null }

> {%
client.test("move media requires auth", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.code === "authentication_failed", "expected authentication_failed");
});
%}
